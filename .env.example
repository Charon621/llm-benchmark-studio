# 本地手动创建 .env；工作台仅从环境读取，不会把密钥写入实验快照。
# Kimi 和 Qwen 均为 OpenAI 兼容 Chat Completions。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.5
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
PORT=8812
AGENTLAB_URL=http://127.0.0.1:8811
# 可选固定 LLM Judge。使用 Qwen 环境密钥，默认关闭。
JUDGE_MODEL=qwen-plus
# 限制 Promptfoo 遥测及远程共享
PROMPTFOO_DISABLE_TELEMETRY=1
