# 优先在网页「模型管理」填写；网页 Key 只保存在后端内存。
# .env 是旧版兼容路径，只允许首次本机会话或 CLI 使用；勿提交此文件的真实值。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.8-flash
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3
XIAOMI_API_KEY=
XIAOMI_BASE_URL=https://api.xiaomimimo.com/v1
XIAOMI_MODEL=mimo-v2.6-pro
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=
STUDIO_ENABLE_LIVE=0
PORT=8812
AGENTLAB_URL=http://127.0.0.1:8811
# 可选固定 LLM Judge。使用 Qwen 环境密钥，默认关闭。
JUDGE_MODEL=qwen3.8-flash
# 限制 Promptfoo 遥测及远程共享
PROMPTFOO_DISABLE_TELEMETRY=1

# 环境模型视觉能力必须显式声明；仅本机原会话可调用环境凭证。
# QWEN_VISION=1
# KIMI_VISION=1
# ANTHROPIC_VISION=1
